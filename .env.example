# Model API (answers + background fact extraction). https://console.anthropic.com
ANTHROPIC_API_KEY=

# Web search. https://app.tavily.com (free tier is enough to try it)
TAVILY_API_KEY=

# Optional
# MODEL=claude-sonnet-5-5        # answering model
# FAST_MODEL=claude-haiku-5-5    # background fact extraction
# PORT=3000
# DB_PATH=data/agent.db
# ALLOW_CLOCK_OVERRIDE=true      # lets the UI pretend it's another date, for testing "last Tuesday"
# DEMO_PATH=demo/history.json    # example history; built on first boot if missing
# MESSAGES_PER_HOUR_PER_VISITOR=40
# MESSAGES_PER_HOUR_PER_IP=80
# MESSAGES_PER_DAY=600
